# Every variable is documented at https://github.com/LukasSor/immich-shared-albums/blob/main/deploy/configuration.md

# An admin API key from Immich, with the permissions listed in deploy/api-key.md
ISA_IMMICH_API_KEY=
ISA_HOUSEHOLD_NAME=The Example household
ISA_IMMICH_URL=http://immich-server:2283

# ISA_LINK_JOIN_REQUIRES_PASSWORD=false
# ISA_BOT_QUOTA_MB=0
# ISA_CACHE_MAX_MB=512
# ISA_RELAY=true
# ISA_ADVERTISE_ADDR=home.example.com:8300

# Keep the state in Postgres instead of SQLite. See deploy/configuration.md
# ISA_DATABASE_PASSWORD=
# ISA_DATABASE_URL=postgres://isa:${ISA_DATABASE_PASSWORD}@isa-postgres:5432/isa
